#!/bin/bash

# Variables
# Input File is the downloaded deck list
INPUT_FILE="cards.xml"
# Output File is the trimmed deck list
OUTPUT_FILE="cards_output.txt"

#SCRIPT_HOME="$(cd -- "$MY_PATH" && pwd)"
SCRIPT_HOME=${HOME}/cards
DATA_HOME=${HOME}/.data/dpsystem

TODAY=$(date +%Y%m%d)
TODAY_DASH=$(date +"%Y-%m-%d")

WA_NATION_LIST="/mnt/nationstates/keepers/keepers_of_the_north.$TODAY.txt"

x_autologin=$(cat ${DATA_HOME}/the_northern_light.cred.dat)

if [ -z $x_autologin ]; then
   echo "Error: No credentials file ${issuing_nation}.cred.dat found."
   exit 1
fi

# Set User Agent
user_agent=$(cat ${DATA_HOME}/useragent.dat)


 
download_deck() {
  # Clear the output file if it exists
  cat /dev/null > "$SCRIPT_HOME/$OUTPUT_FILE"

  url="https://www.nationstates.net/cgi-bin/api.cgi"
  curl_data="q=cards+deck;nationname=the_northern_light"
  response=$(curl -A "Sil Dorsett" "$url" --data "$curl_data" --http1.1)
  echo $response | xmllint --format - > $SCRIPT_HOME/${INPUT_FILE}

  # Parse the XML and extract relevant fields
  xmlstarlet sel -t \
    -m "//CARD[CATEGORY='legendary']" \
    -v "concat(CARDID, '|', CATEGORY, '|', SEASON)" \
    -n "$INPUT_FILE" | while read -r line; do
      echo "$line" >> "$SCRIPT_HOME/$OUTPUT_FILE"
    done

echo "Parsing complete. Output saved to $SCRIPT_HOME/$OUTPUT_FILE."
}


### RUN LOTTERY ###
run_lottery() {

  # Deck file (the file with the parsed cards)
  local DECK_FILE="${SCRIPT_HOME}/cards_output.txt"

  # Check if the file exists and is not empty
  if [[ ! -s "$DECK_FILE" ]]; then
    echo "Error: Deck file is either missing or empty."
    exit 1
  fi

  # Count the number of lines in the file
  TOTAL_LINES=$(wc -l < "$DECK_FILE")

  # Generate a random line number between 1 and the total number of lines
  RANDOM_LINE=$((RANDOM % TOTAL_LINES + 1))

  # Extract the specific line from the file
  SELECTED_LINE=$(sed -n "${RANDOM_LINE}p" "$DECK_FILE")

  # Do something with the selected line (e.g., print it)
  echo "Lines in File: $TOTAL_LINES"
  echo "Randomly selected line: Line $RANDOM_LINE"
  echo "Contents of Line $RANDOM_LINE: $SELECTED_LINE"
  card_id=$(echo "$SELECTED_LINE" | cut -d"|" -f1)
  season_id=$(echo "$SELECTED_LINE" | cut -d"|" -f3)
  echo "Card ID = ${card_id}"
  echo "Season = ${season_id}"
  echo "----------------------------------------"
  TOTAL_WA_COUNT=$(wc -l < "$WA_NATION_LIST")
  RANDOM_WA_LINE=$((RANDOM % TOTAL_WA_COUNT + 1))
  RANDOM_WA_NATION=$(sed -n "${RANDOM_WA_LINE}p" "$WA_NATION_LIST")
  echo "Total WAs in TNP: ${TOTAL_WA_COUNT}"
  echo "Selected WA Line: Line ${RANDOM_WA_LINE}"
  echo "Selected Nation: ${RANDOM_WA_NATION}"
}

deliver_card() {
  ### SEND CARD ###
  url="https://www.nationstates.net/cgi-bin/api.cgi"
  curl_data="nation=the_northern_light"
  curl_data="${curl_data}&c=giftcard"
  curl_data="${curl_data}&cardid=${card_id}"
  curl_data="${curl_data}&season=${season_id}"
  curl_data="${curl_data}&to=${RANDOM_WA_NATION}"

  curl_prepare="${curl_data}&mode=prepare"

  response_prepare=$(curl -i -H "X-Autologin: $x_autologin" -A "$user_agent" "$url" --data "$curl_prepare" --http1.1)

  echo "$response_prepare"

  token=$(echo $response_prepare | grep -o '<SUCCESS>.*</SUCCESS>' | sed -e 's/<SUCCESS>//;s/<\/SUCCESS>//')
  x_pin=$(echo "$response_prepare" | awk '/^X-pin:/ {print $2}')

  echo "token: $token"
  echo "x-pin: $x_pin"

  if [ -z $token ]; then
          echo "[ERROR] Token not received." ; exit 1
  else
          sleep 2
          curl_execute="${curl_data}&mode=execute&token=$token"
          response_execute=$(curl -H "X-Pin: $x_pin" -A "$user_agent" "$url" --data "$curl_execute" --http1.1)
          echo "$curl_execute"
          echo "$response_execute"
  fi
}

get_card_name() {
  # Clear the output file if it exist
  local TEMP_FILE="/tmp/card_info.xml"
  cat /dev/null > "$TEMP_FILE"

  url="https://www.nationstates.net/cgi-bin/api.cgi"
  curl_data="q=card+info;cardid=${card_id};season=${season_id}"
  response=$(curl -A "Sil Dorsett" "$url" --data "$curl_data" --http1.1)
  echo $response | xmllint --format - > ${TEMP_FILE}

  # Extract the Card Name
  card_name=$(awk -F'[<>]' '/<NAME>/ {print $3}' $TEMP_FILE)

  echo "Card Name: $card_name"
  rm $TEMP_FILE
}



make_rmb_post() {
  sed -e "s/@@DATE@@/$TODAY_DASH/" \
      -e "s/@@WINNER@@/$RANDOM_WA_NATION/" \
      -e "s/@@SEASON@@/$season_id/g" \
      -e "s/@@CARD_ID@@/$card_id/" \
      -e "s/@@CARD_NAME@@/$card_name/" ${SCRIPT_HOME}/rmb_post_template.txt > ${SCRIPT_HOME}/rmbposts/rmb_post_$TODAY.txt

  rmb_post=$(cat ${SCRIPT_HOME}/rmbposts/rmb_post_$TODAY.txt)
  rmb_post_text=$(echo -n "$rmb_post" | jq -s -R -r @uri)

  ### SEND CARD ###
  url="https://www.nationstates.net/cgi-bin/api.cgi"
  curl_data="nation=the_northern_light"
  curl_data="${curl_data}&region=the_north_pacific"
  curl_data="${curl_data}&c=rmbpost"
  curl_data="${curl_data}&text=${rmb_post_text}"
  
  curl_prepare="${curl_data}&mode=prepare"

  echo "curl_prepare = ${curl_prepare}"

  # Since this is the second request in quick succession, we will use the X-Pin instead.
  response_prepare=$(curl -i -H "X-Pin: $x_pin" -A "$user_agent" "$url" --data "$curl_prepare" --http1.1)

  echo "$response_prepare"

  token=$(echo $response_prepare | grep -o '<SUCCESS>.*</SUCCESS>' | sed -e 's/<SUCCESS>//;s/<\/SUCCESS>//')

  echo "token: $token"

  if [ -z $token ]; then
          echo "[ERROR] Token not received." ; exit 1
  else
          sleep 2
          curl_execute="${curl_data}&mode=execute&token=$token"
          response_execute=$(curl -H "X-Pin: $x_pin" -A "$user_agent" "$url" --data "$curl_execute" --http1.1)
          echo "$curl_execute"
         echo "$response_execute"
  fi
}

download_deck
run_lottery
get_card_name
deliver_card
make_rmb_post
